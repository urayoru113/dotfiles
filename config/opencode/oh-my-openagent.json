{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "hephaestus": {
      "model": "airforce/gpt-5.4",
      "fallback_models": [
        {
          "model": "openrouter/gpt-5.3-codex"
        }
      ]
    },
    "oracle": {
      "model": "airforce/gpt-5.4",
      "variant": "high",
      "fallback_models": [
        {
          "model": "airforce/gemini-3.1-pro"
        },
        {
          "model": "opencode-go/glm-5.1"
        }
      ]
    },
    "librarian": {
      "model": "google/gemini-3.1-flash-lite",
      "fallback_models": [
        {
          "model": "opencode-go/qwen-3.5-plus"
        }
      ]
    },
    "explore": {
      "model": "google/gemini-3.1-flash-lite",
      "fallback_models": [
        {
          "model": "opencode-go/minimax-m2.7"
        }
      ]
    },
    "multimodal-looker": {
      "model": "openrouter/z-ai/glm-4.5-air:free"
    },
    "prometheus": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        {
          "model": "airforce/gemini-3.1-pro"
        },
        {
          "model": "opencode-go/glm-5.1"
        }
      ]
    },
    "metis": {
      "model": "airforce/gpt-5.4",
      "fallback_models": [
        {
          "model": "opencode-go/glm-5.1"
        },
        {
          "model": "opencode-go/glm-5.1"
        }
      ]
    },
    "momus": {
      "model": "airforce/gpt-5.4",
      "variant": "high",
      "fallback_models": [
        {
          "model": "airforce/gemini-3.1-pro"
        },
        {
          "model": "openrouter/gemini-3.1-pro"
        }
      ]
    },
    "atlas": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        {
          "model": "opencode-go/minimax-m2.5"
        }
      ]
    },
    "sisyphus-junior": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        {
          "model": "opencode/big-pickle"
        }
      ]
    },
    "sisyphus": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        {
          "model": "opencode-go/kimi-k2.6"
        }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/gemini-3.1-flash-lite",
      "variant": "high",
      "fallback_models": [
        {
          "model": "opencode-go/qwen-3.5-plus"
        }
      ]
    },
    "ultrabrain": {
      "model": "airforce/gpt-5.4",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "openrouter/gpt-5.4",
          "variant": "xhigh"
        }
      ]
    },
    "deep": {
      "model": "airforce/gpt-5.4",
      "fallback_models": [
        {
          "model": "openrouter/gogole/gemini-3.1-pro"
        },
        {
          "model": "opencode-go/glm-5.1"
        }
      ],
      "variant": "high"
    },
    "artistry": {
      "model": "google/gemini-3.5-flash",
      "fallback_models": [
        {
          "model": "google/gemini-3.1-flash-lite"
        },
        {
          "model": "opencode-go/qwen3.5-plus"
        }
      ],
      "variant": "high"
    },
    "quick": {
      "model": "google/gemini-3.1-flash-lite",
      "fallback_models": [
        {
          "model": "opencode-go/minimax-m2.7"
        }
      ]
    },
    "unspecified-low": {
      "model": "google/gemini-3.1-flash-lite",
      "fallback_models": [
        {
          "model": "openrouter/moonshotai/kimi-k2.6:free"
        }
      ]
    },
    "unspecified-high": {
      "model": "opencode-go/glm-5",
      "fallback_models": [
        {
          "model": "openrouter/moonshotai/kimi-k2.6:free"
        },
        {
          "model": "opencode-go/kimi-k2.6"
        }
      ]
    },
    "writing": {
      "model": "google/gemini-3.1-flash-lite",
      "fallback_models": [
        {
          "model": "opencode-go/deepseek-v4-flash"
        }
      ]
    }
  },
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      429,
      402,
      500,
      502,
      503
    ],
    "cooldown_seconds": 5,
    "timeout_seconds": 60,
    "max_fallback_attempts": 3
  },
  "background_task": {
    "staleTimeoutMs": 180000,
    "defaultConcurrency": 1,
    "taskTtlMs": 300000,
    "messageStalenessTimeoutMs": 60000
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  }
}
