{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.dotfiles/ai/rules/AGENTS.md",
    "~/.dotfiles/ai/rules/MEMORY.md"
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "oh-my-opencode-slim@latest",
    "token-optimizer-opencode",
    // "oh-my-openagent@latest",
  ],
  "mcp": {
    "ddg_search": {
      "type": "local",
      "command": [
        "uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": false
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git",
      ]
    },
    "you_search": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@youdotcom-oss/mcp"
      ],
      "enabled": false,
      "environment": {
        "YDC_PROFILE": "free"
      }
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "environment": {
        "PYTHONIOENCODING": "utf-8"
      },
      "enabled": false,
    },
    "codemem": {
      "type": "local",
      "command": [
        "bunx",
        "codemem",
        "mcp"
      ],
      "enabled": true
    }
  },
  "lsp": true,
  "provider": {
    "openrouter": {
      "models": {
        "free": {},
        "owl-alpha": {}
      },
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "google": {
      "models": {
        "gemma-4-26b-a4b-it": {},
        "gemma-4-31b-it": {}
      },
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "groq": {
      "models": {},
      "options": {
        "apiKey": "{env:GROQ_API_KEY}"
      }
    },
    "chutes": {
      "models": {},
      "options": {
        "apiKey": "{env:CHUTES_API_KEY}"
      }
    },
    "airforce": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AirForce",
      "options": {
        "baseURL": "https://api.airforce/v1",
        "apiKey": "{env:AIRFORCE_API_KEY}"
      },
      "models": {
        "seed-rp": {
          "name": "seed-rp",
